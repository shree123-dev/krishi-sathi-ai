# ========================================================
# Krishi Sathi AI — Environment Configuration Template
# ========================================================

# Flask Server Configuration
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=dev-secret-key-krishi-sathi-ai-2026
SESSION_TIMEOUT_MINUTES=10080

# Administrative API Key (Module 2: Required to verify Officer accounts via /api/auth/admin/verify-officer)
ADMIN_API_KEY=krishi-sathi-admin-secure-key-2026

# Database Configuration (Module 10)
# Default: SQLite for immediate local persistence without installing PostgreSQL.
# For production PostgreSQL / Supabase, uncomment and configure:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crop_health_db
DATABASE_URL=sqlite:///krishi_sathi.db

# Machine Learning Model Integration (Module 3)
# To preserve scientific integrity, ML_MODEL_ENABLED must remain False until your model weights are trained.
# When ready: set ML_MODEL_ENABLED=True, provide absolute ML_MODEL_PATH, and calibrate CONFIDENCE_ESCALATION_THRESHOLD.
ML_MODEL_ENABLED=False
ML_MODEL_PATH=
CONFIDENCE_ESCALATION_THRESHOLD=0.75

# Environmental & Weather Data Providers (Module 8)
# Open-Meteo free API for live regional atmospheric cluster data (No API key required)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# File Storage Configuration (Module 9)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# External SMS Gateways for Officer Escalation Alerts (Module 4)
# IMPORTANT: Keep blank unless genuine provider accounts are configured.
# If unconfigured, the system gracefully creates guaranteed in-app officer alerts without crashing.

# Option A: Twilio (Global / India)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1234567890

# Option B: MSG91 (Indian DLT-approved SMS Gateway)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=KRISHI
MSG91_TEMPLATE_ID=

# Email SMTP (Optional)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
